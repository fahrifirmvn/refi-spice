# =============================================================================
# Refi Spice — Environment Configuration
# Lihat PRD_Refi_Spice_MASTER_v2.md Section 13 untuk penjelasan lengkap.
# Salin file ini ke `.env` lalu sesuaikan nilainya. JANGAN commit `.env` ke Git.
# =============================================================================

APP_NAME="Refi Spice"
APP_ENV=local                      # local | production
APP_KEY=                           # generate via `php artisan key:generate`
APP_DEBUG=true                     # WAJIB false di production (jangan bocorkan stack trace)
APP_URL=http://localhost:8000      # ganti ke https://www.refi-spice.com di production

APP_LOCALE=id                      # Bahasa Indonesia (i18n multi-bahasa di luar scope fase ini)
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# PRD Section 7.2 — tampilkan watermark "PLACEHOLDER — MENUNGGU ASET KLIEN" di
# atas slot gambar yang belum punya foto asli. Set `false` setelah semua aset
# gambar klien sudah diunggah lewat admin panel.
SHOW_PLACEHOLDER_WATERMARK=true

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                    # gunakan "error" atau "warning" di production

# -----------------------------------------------------------------------------
# Database
# Lokal: MySQL/MariaDB (lebih representatif ke production dibanding SQLite).
# Production: MySQL juga, tinggal ganti host/kredensial (Section 13.2).
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=refi_spice
DB_USERNAME=refi_spice
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public             # dipakai spatie/laravel-medialibrary untuk upload gambar
QUEUE_CONNECTION=sync              # LOKAL: sync. PRODUCTION WAJIB "database" (lihat PRD Section 12.2) —
                                    # direct-send SMTP bisa lambat, jangan blocking request user di production.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail — Section 12 (Arsitektur Mail Server)
# Lokal: Mailpit (SMTP :1025, web UI :8025) sebagai pengganti mail server asli.
# Production (direct-send): MAIL_HOST=mail.refi-spice.com, MAIL_PORT=587, MAIL_SCHEME=tls.
# Migrasi ke relay pihak ketiga = ganti blok ini saja, TIDAK ada perubahan kode (Section 12.1).
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null                   # null di lokal (Mailpit tanpa TLS). Production: tls
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@refi-spice.local"
MAIL_FROM_NAME="Refi Spice (Local)"
MAIL_SALES_ADDRESS="sales@refi-spice.com"   # tujuan notifikasi inquiry baru (config/mail.php sales_notification_address)
                                             # gunakan alamat sementara jika sales@ belum aktif/dipantau

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Anti-Spam — Section 11 (opsional, pertimbangkan hanya jika honeypot+rate-limit
# masih kebobolan spam setelah go-live)
# -----------------------------------------------------------------------------
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
